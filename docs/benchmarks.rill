/*
 * Rill Benchmark Examples
 *
 * Classic language benchmarks implemented in Rill. These serve both as
 * performance baselines and as examples of how the language feels for
 * non-trivial computation.
 *
 * Each benchmark is a standalone function callable by the embedder.
 */

// ============================================================================
// Fibonacci (recursive)
// ============================================================================
//
// The classic recursive fibonacci. Tests function call overhead,
// recursion depth, and integer arithmetic.
//
// fib(30) = 832040 (makes ~2.7M function calls)
// fib(35) = 9227465 (makes ~29.9M function calls)

fn fib(n) {
    if n < 2 { n } else { fib(n - 1) + fib(n - 2) }
}

// Iterative fibonacci for comparison — tests loop overhead and
// variable reassignment instead of recursion.

fn fib_iter(n) {
    if n < 2 {
        return n;
    }

    let a = 0;
    let b = 1;
    for _i in 2..=n {
        let next = a + b;
        a = b;
        b = next;
    }
    b
}

// ============================================================================
// Binary Trees
// ============================================================================
//
// Allocates and traverses binary trees. Tests heap allocation (maps),
// recursive data structures, type-based dispatch, and GC pressure.
//
// Adapted from the Computer Language Benchmarks Game.
// A tree is either a leaf (UInt) or an internal node (Map with left/right).

fn make_tree(depth) {
    if depth == 0 {
        1
    } else {
        {
            "left": make_tree(depth - 1),
            "right": make_tree(depth - 1)
        }
    }
}

fn check_tree(node) {
    // Use if-let to check if node.left exists (maps have it, leaf UInts don't)
    if let left = node.left {
        1 + check_tree(left) + check_tree(node.right)
    } else {
        1
    }
}

// Build and check trees of increasing depth.
// Returns the total node count across all trees.

fn binary_trees(max_depth) {
    let total = 0;

    for depth in 0..=max_depth {
        let tree = make_tree(depth);
        total += check_tree(tree);
    }

    total
}

// ============================================================================
// Ackermann Function
// ============================================================================
//
// Deeply recursive function that grows extremely fast.
// Tests recursion and stack depth limits.
//
// ack(3, 4) = 125 (modest recursion)
// ack(3, 8) = 2045 (deep recursion)
// ack(3, 10) = 8189 (very deep)
// ack(4, 1) = 65533 (extreme — may hit stack limit)

fn ack(m, n) {
    if m == 0 {
        n + 1
    } else if n == 0 {
        ack(m - 1, 1)
    } else {
        ack(m - 1, ack(m, n - 1))
    }
}

// ============================================================================
// Tak Function
// ============================================================================
//
// Takeuchi function — another recursion-heavy benchmark.
// Tests function call overhead with 3 arguments.
//
// tak(18, 12, 6) = 7 (makes ~170K calls)
// tak(24, 16, 8) = 9 (makes ~7.5M calls)

fn tak(x, y, z) {
    if y < x {
        tak(tak(x - 1, y, z), tak(y - 1, z, x), tak(z - 1, x, y))
    } else {
        z
    }
}

// ============================================================================
// Sum of Primes (Sieve-like)
// ============================================================================
//
// Tests array construction, nested loops, modulo arithmetic, and
// conditional logic. Not a true sieve (no array mutation for marking),
// but exercises similar patterns.

fn is_prime(n) {
    if n < 2 { return false; }
    if n < 4 { return true; }
    if n % 2 == 0 { return false; }

    let i = 3;
    while i * i <= n {
        if n % i == 0 {
            return false;
        }
        i += 2;
    }
    true
}

fn sum_primes(limit) {
    let total = 0;
    for n in 2..limit {
        if is_prime(n) {
            total += n;
        }
    }
    total
}

// ============================================================================
// Collatz Conjecture
// ============================================================================
//
// Compute the Collatz sequence length for each number up to limit.
// Tests conditional branching, integer arithmetic, while loops.

fn collatz_length(n) {
    let steps = 0;
    while n != 1 {
        if n % 2 == 0 {
            n = n / 2;
        } else {
            n = n * 3 + 1;
        }
        steps += 1;
    }
    steps
}

fn max_collatz(limit) {
    let max_steps = 0;
    let max_n = 1;
    for n in 1..limit {
        let steps = collatz_length(n);
        if steps > max_steps {
            max_steps = steps;
            max_n = n;
        }
    }
    max_n
}

// ============================================================================
// Map Operations
// ============================================================================
//
// Exercises map construction, key lookup, iteration, and nested maps.
// Tests HeapVal CoW semantics and IndexMap performance.

fn build_map(size) {
    let m = {};
    for i in 0..size {
        m[i] = i * i;
    }
    m
}

fn sum_map_values(m) {
    let total = 0;
    for key, value in m {
        total += value;
    }
    total
}

fn map_benchmark(size) {
    let m = build_map(size);
    sum_map_values(m)
}

// ============================================================================
// Array Accumulation
// ============================================================================
//
// Build an array via append, then reduce it.
// Tests array growth, append intrinsic, and iteration.

fn array_sum(size) {
    let arr = [];
    for i in 0..size {
        append(arr, i);
    }

    let total = 0;
    for val in arr {
        total += val;
    }
    total
}

// ============================================================================
// Nested Loop (Matrix-like)
// ============================================================================
//
// Simulates a matrix multiply accumulation pattern.
// Tests nested for loops with range sequences.

fn matrix_trace(size) {
    let total = 0;
    for i in 0..size {
        for j in 0..size {
            if i == j {
                total += i * j;
            }
        }
    }
    total
}

// ============================================================================
// Bitwise Operations
// ============================================================================
//
// Tests the @ bit test operator, bitwise arithmetic, and shifts.

fn popcount(x) {
    let count = 0;
    for bit in 0..64 {
        if x @ bit {
            count += 1;
        }
    }
    count
}

fn hamming_distance(a, b) {
    popcount(a ^ b)
}

fn bitwise_benchmark(iterations) {
    let total = 0;
    for i in 0..iterations {
        total += popcount(i);
    }
    total
}
